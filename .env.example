# Copy this file to `.env.local`. Never commit `.env.local`.
#
# Every value below is baked into the client bundle at build time (the
# NEXT_PUBLIC_ prefix means exactly that), so nothing here may be a secret.
# There are no secrets in this app: it has no backend.

# ---------------------------------------------------------------------------
# Starknet mainnet RPC.
#
# Optional. Without it the app falls back to a short list of keyless public
# endpoints and tries them in order, so a clone runs read-only out of the box.
# Public endpoints are rate-limited and occasionally slow — for anything beyond
# trying it out, paste your own Alchemy or Nethermind URL here.
NEXT_PUBLIC_STARKNET_RPC_URL=

# ---------------------------------------------------------------------------
# Deployed contracts, Starknet mainnet.
#
# These are the live instances this repository ships against. Leave them as
# they are to run against the real deployments; change them only if you deploy
# your own with `node contracts/deploy.mjs --contract <escrow|splitter|vault>`.
#
# Claim links, batch payouts, both claim doors, reclaim.
NEXT_PUBLIC_LUMEN_ESCROW_ADDRESS=0x6c96b86d5f1eaee16be18ca4f346edb20c098f1106648cef3845b34723df272

# Private Bitcoin staking: shielded strkBTC into Endur, never unshielding.
NEXT_PUBLIC_LUMEN_VAULT_ADDRESS=0x73e57be7d6c9d2321d7a01d0c2e426392fd5e736ecfbcd91d4216ba5d7a5f67

# One private amount into N non-round notes in one operation.
NEXT_PUBLIC_LUMEN_SPLITTER_ADDRESS=0x44d15d99fd2fa3a2d44e4c0e2b70e5efc2870009e2ed810380ab20a46b5c7a0
