# Starknet mainnet RPC.
# Create a free key at https://www.alchemy.com and paste it below.
# Copy this file to `.env.local`. Never commit `.env.local`.
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional. Only needed for AVNU's `sponsored_private` fee mode.
# This is a SERVER-side secret: it must never be prefixed NEXT_PUBLIC_,
# and the call that uses it must stay in a route handler, never the browser.
AVNU_PAYMASTER_API_KEY=

# Deployed LumenEscrow anonymizer (claim links). Leave empty until you have
# run contracts/deploy.sh and deployed your own instance — the "Pay with a
# link" flow stays hidden without it.
NEXT_PUBLIC_LUMEN_ESCROW_ADDRESS=
